generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum CustomerType {
  residential
  commercial
  property_manager
  government
}

enum PreferredContactMethod {
  call
  text
  email
}

enum LeadSource {
  GMB
  word_of_mouth
  contract_account
  website
  other
}

enum LeadCategory {
  commercial
  residential
  automotive
  safe
}

enum LeadUrgency {
  low
  normal
  high
  emergency
}

enum LeadStatus {
  new
  contacted
  quoted
  scheduled
  won
  lost
  nurture
}

enum JobType {
  commercial
  residential
  automotive
  safe
}

enum JobSource {
  organic
  contract
}

enum ContractAccountName {
  OCU
  BASS
  EVO
  Academy
}

enum JobStatus {
  intake
  quoted
  scheduled
  in_progress
  waiting_on_parts_or_approval
  completed
  invoiced
  paid
  follow_up_review_request
  archived
}

enum InvoiceStatus {
  draft
  sent
  paid
  partial
  overdue
}

enum AssetType {
  app
  game
  comic_kdp
  graphic_pack
  template
  video_script
  seo_article
}

enum AssetStatus {
  idea
  in_progress
  review
  published
  archived
}

model Customer {
  id                     String                 @id @default(cuid()) @map("customer_id")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  name                   String
  phone                  String?
  email                  String?
  address                String?
  customerType           CustomerType?
  preferredContactMethod PreferredContactMethod?
  notes                  String?
  tags                   String? // comma-separated (simple v1)

  jobs                   Job[]
  leads                  Lead[]
}

model Lead {
  id              String       @id @default(cuid()) @map("lead_id")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  source          LeadSource
  category        LeadCategory
  urgency         LeadUrgency  @default(normal)
  status          LeadStatus   @default(new)
  estimatedValue  Int?         // store cents later; v1 uses whole dollars
  nextFollowUpAt  DateTime?
  notes           String?
}

model ContractAccount {
  id                 String               @id @default(cuid()) @map("account_id")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  accountName        ContractAccountName  @unique
  contacts           String?              // JSON later; v1 text
  serviceLevelNotes  String?
  billingTerms       String?
  preferredWorkflow  String?
  monthlyRevenueTarget Int?
  notes              String?

  jobs               Job[]
}

model Job {
  id              String        @id @default(cuid()) @map("job_id")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  jobType         JobType
  jobSubtype      String?

  source          JobSource
  contractAccountId String?
  contractAccount ContractAccount? @relation(fields: [contractAccountId], references: [id], onDelete: SetNull)

  // mirrored from JSON spec
  siteName        String?
  address         String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  assignedTo      String?
  status          JobStatus     @default(intake)
  materialsNeeded String?
  photosLinks     String?
  notes           String?

  invoice         Invoice?
}

model Invoice {
  id            String        @id @default(cuid()) @map("invoice_id")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  jobId         String        @unique
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  lineItems     String?       // JSON later; v1 text
  laborTotal    Int?
  materialsTotal Int?
  taxTotal      Int?
  total         Int?
  status        InvoiceStatus @default(draft)
  paymentMethod String?
  paidAt        DateTime?
  notes         String?
}

model AssetCreated {
  id           String      @id @default(cuid()) @map("asset_id")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assetType    AssetType
  title        String
  status       AssetStatus @default(idea)
  platform     String?
  linkOrRepo   String?
  nextAction   String?
  notes        String?
}
